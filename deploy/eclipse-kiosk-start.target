# ==============================================================================
# File:    eclipse-kiosk-start.target
# Purpose: Kiosk start LATCH (US-651-a, Atlas RULED 2026-10-24 option c). The
#          mode's .path unit (eclipse-kiosk-socket.path in wayland,
#          eclipse-x-ready.path in x11) starts this target when the display is
#          ready; it pulls splash-boot.service in by dependency and stays
#          active for the rest of the boot.
# Author:  Rex (Ralph Agent)
# Created: 2026-10-24 -- Sprint 113 US-651-a
#
# Why a latch and not Unit=splash-boot.service on the .path: systemd.path(5)
# re-checks a PathExists= path when the unit it triggered goes inactive, and
# starts it again. wayland-0 and the eclipse-x-ready marker persist all
# session, so a .path naming splash-boot would re-show the splash over the
# dashboard after every hand-off. A target has no process: it cannot hang or
# fail, and once reached it stays active until shutdown, so the .path never
# re-fires: once per boot, as WantedBy=graphical.target was before.
#
# Default dependencies stay ON: the implicit After=splash-boot.service means the
# target is reached once splash-boot's start job ends (success or failure), and
# the implicit Conflicts=shutdown.target stops the latch at shutdown.
#
# Wants= is WEAK: splash-boot exiting or failing does not touch the latch, and
# splash-boot's own OnSuccess= / OnFailure= still hand off to
# eclipse-dashboard.service exactly as before.
#
# No [Install] section: the .path units are the only thing that starts it.
# Installed every deploy by `eclipse-display-mode trigger` (deploy-pi.sh
# step_install_ui_kiosk_units).
# ==============================================================================

[Unit]
Description=Kiosk start latch: reached once per boot when the display is ready
Wants=splash-boot.service
