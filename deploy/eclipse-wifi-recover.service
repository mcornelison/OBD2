# ==============================================================================
# File:    eclipse-wifi-recover.service
# Purpose: Retry a stored-PSK Wi-Fi connection ONCE after NetworkManager fails
#          it with NO_SECRETS (US-925-a / F-155)
# Author:  Rex (Ralph Agent)
# Created: 2026-10-25 -- US-925-a (Atlas design; Atlas RULED Q-925-1)
# Changed: 2026-10-26 -- US-925-c: root-owned script path, Type=notify
#
# Why
# ---
# After a handshake failure NetworkManager walks a stored-PSK connection
# need-auth -> no secrets -> failed and never retries it. MEASURED on 2 of 25
# boots: the Pi was offline 8 and 63 minutes, until a power-cycle. The key is
# still stored; nothing asks NM to use it again. src/pi/network/wifi_recover.py
# listens for Device.StateChanged (wlan0, FAILED, reason NO_SECRETS) and runs
# `nmcli connection up uuid U` ONCE per ACTIVATED -- see its docstring for the
# rearm rule. Recovery, not prevention: the 5 GHz move happens below the
# supplicant, and band=bg, freq_list and roamoff=1 are already set (MEASURED).
#
# Root, on purpose (no User=)
# ---------------------------
# NM's network-control polkit action is auth_admin for a caller with no
# session, so an unprivileged unit could not re-activate the connection. A
# polkit grant to mcornelison would also reach Chromium, which runs as that
# user. Precedent: eclipse-rfkill-unblock.service. No polkit rule is added.
# The sandbox below is what keeps root small: no new privileges, an EMPTY
# capability bounding set, a read-only OS, NO home directories at all, a
# private /tmp, and AF_UNIX only (the system bus, the journal and the notify
# socket).
#
# The root-owned copy (US-925-c, Atlas RULED)
# -------------------------------------------
# Root with an empty capability set has no CAP_DAC_OVERRIDE, so it cannot
# enter the deploy user's 0700 home: run from the repo checkout, this unit
# crash-looped with Errno 13 while the deploy reported it active (V0.30.15).
# The deploy step copies src/pi/network/wifi_recover.py to
# /usr/local/lib/eclipse/wifi_recover.py (root:root 0644, cmp-verified), so the
# unit needs no path in a home directory and ProtectHome=yes hides them all.
# No CAP_DAC_* is added: the fix is the path, not a wider capability set.
#
# Type=notify: wifi_recover.main sends READY=1 on $NOTIFY_SOCKET only after
# its StateChanged subscription is in place, so `systemctl restart` returns
# only once the service is really listening (or fails at the start timeout).
# NotifyAccess=main: the nmcli children it launches cannot speak for it.
#
# The SYSTEM python, not obd2-venv
# --------------------------------
# dbus and gi come from Debian python3-dbus / python3-gi. obd2-venv has
# include-system-site-packages=false and `import dbus` fails there (MEASURED).
# deploy-pi.sh's step_install_wifi_recover_unit FAILS the deploy when either
# package is missing; a deploy never installs packages.
#
# PartOf=NetworkManager.service: an NM restart restarts this unit too, so it
# re-subscribes on the new NM. The subscription is on ANY object path anyway
# (device paths change when NM restarts).
#
# Installation: deploy/deploy-pi.sh step_install_wifi_recover_unit (sync-if-
# changed unit + script copy, daemon-reload-on-change, enable + restart, every
# deploy). The step FAILS unless the restart exits 0, NRestarts is 0 and this
# invocation's journal has the "watching wlan0" line. It never restarts
# NetworkManager and never reloads brcmfmac, so SSH survives a deploy.
#
# Verify:
#   systemctl is-active eclipse-wifi-recover              # -> active
#   systemctl show -p NRestarts --value eclipse-wifi-recover  # -> 0
#   journalctl -u eclipse-wifi-recover -b                 # -> "watching wlan0 ..."
# ==============================================================================

[Unit]
Description=Retry a Wi-Fi connection once after a NetworkManager no-secrets failure (US-925-a)
After=NetworkManager.service
PartOf=NetworkManager.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /usr/local/lib/eclipse/wifi_recover.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
