# ==============================================================================
# File:    splash-boot.service.x11  (one of two variants; install.sh picks)
# Purpose: F-103 status-aware boot splash, X11 fallback. Same as the Wayland
#          variant but talks to an X server (DISPLAY=:0) instead of Wayland.
#          install.sh selects this only when the detected session type is x11
#          (V-2); guessing wrong gives the D-3 class of bug, so detection must
#          fail loudly rather than default.
# Author:  Ralph Agent (Rex)  (D-3 corrected unit per spec §7)
# Created: 2026-06-29 -- Sprint 48 US-393 (F-103 boot splash)
#
# Token SSOT: chromium loads http://127.0.0.1:9899/ so the token is injected
#   same-origin and never lands on disk. Requires eclipse-states-http.
# Type=simple [A-8]. __PI_USER__ substituted by install.sh (V-1).
#
# I-044 (US-550) -- XDG_RUNTIME_DIR is __PI_UID__, NOT the %U specifier. Measured
#   on the live Pi: with User=mcornelison (id -u = 1000), `systemctl show
#   splash-boot.service -p Environment` reported XDG_RUNTIME_DIR=/run/user/0 --
#   root's dir, which this unit's user cannot write and which does not exist
#   (`ls -d /run/user/*` -> /run/user/1000). Consequence in the boot dc7a3848
#   journal: "unable to create directory '/run/user/0/dconf': Permission denied"
#   x3 plus a run of dbus "Could not parse server address". So the uid is
#   resolved at INSTALL time by install.sh (V-4, `id -u $PI_USER`) and
#   substituted here, exactly like __PI_USER__ and __CHROMIUM_BIN__. Do not
#   "simplify" it back to %U -- it looks correct in the file and is not.
# ==============================================================================

[Unit]
Description=Animated boot splash (status-aware, X11)
After=graphical.target eclipse-states-http.service eclipse-boot-state.service
Wants=graphical.target eclipse-states-http.service eclipse-boot-state.service
# A-1 hand-off (US-399): at HEALTHY_YIELD the splash JS calls window.close(),
# this Type=simple unit exits 0, and systemd starts the carousel dashboard. A
# DEGRADED boot keeps the splash up (no window.close) -> no dashboard hand-off.
OnSuccess=eclipse-dashboard.service

[Service]
Type=simple
User=__PI_USER__
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/__PI_UID__
ExecStart=__CHROMIUM_BIN__ \
  --kiosk \
  --noerrdialogs --disable-infobars --hide-scrollbars \
  --autoplay-policy=no-user-gesture-required \
  --check-for-update-interval=31536000 \
  --user-data-dir=/tmp/splash-chromium-boot \
  http://127.0.0.1:9899/
# Splash exits via JS window.close() at HEALTHY_YIELD / DEGRADED (D-3).

[Install]
WantedBy=graphical.target
