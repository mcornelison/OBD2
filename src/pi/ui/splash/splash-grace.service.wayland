# ==============================================================================
# File:    splash-grace.service.wayland  (one of two variants; install.sh picks)
# Purpose: F-103 grace-period shutdown splash, Bookworm/Wayland. Activated by
#          splash-grace.path the instant shutdown-state appears. Chromium kiosk
#          renders the reverse dim-down + polls /shutdown-state via the localhost
#          state server. Type=simple [A-8] -- oneshot plus the self-cancel
#          directive were D-2's root cause and are rejected here. JS-driven exit
#          (window.close), no external kill.
# Author:  Ralph Agent (Rex)
# Created: 2026-06-29 -- Sprint 48 US-396 (F-103 shutdown splash, D-2 replacement)
#
# Token SSOT: chromium loads http://127.0.0.1:9899/shutdown.html (NOT a file://
#   asset) so the state server injects the token same-origin -- it never lands on
#   disk. Requires eclipse-states-http.service. __PI_USER__ substituted by
#   install.sh at install time (V-1).
#
# US-549 (I-043) -- `--enable-logging=stderr` is LOAD-BEARING, not a debug leftover.
#   shutdown-state-poll.js logs its terminal reason to the console on every exit;
#   chromium DISCARDS console output unless this flag is set, so without it the
#   splash still exits silently and I-043 is unfixed. No `--log-level` is pinned:
#   chromium logs web-content console messages at INFO regardless of the console
#   method used, so raising the threshold would filter out the very line this
#   unit exists to surface. The noise budget is a few seconds once per shutdown,
#   unlike the long-running dashboard kiosk, which deliberately carries no
#   logging flag. NOT adopted alongside it: `--remote-debugging-port` (US-522 --
#   an unauthenticated page-control surface on a car-mounted kiosk).
#
# I-044 (US-550) -- XDG_RUNTIME_DIR is __PI_UID__, NOT the %U specifier. Measured
#   on the live Pi: with User=mcornelison (id -u = 1000), `systemctl show
#   splash-boot.service -p Environment` reported XDG_RUNTIME_DIR=/run/user/0 --
#   root's dir, which this unit's user cannot write and which does not exist.
#   Consequence in the boot dc7a3848 journal: "unable to create directory
#   '/run/user/0/dconf': Permission denied" x3 plus a run of dbus "Could not
#   parse server address". The uid is resolved at INSTALL time by install.sh
#   (V-4, `id -u $PI_USER`) and substituted here, exactly like __PI_USER__.
#   LOAD-BEARING on Wayland specifically: the compositor socket is
#   $XDG_RUNTIME_DIR/wayland-0. It also keeps the dbus noise out of the same
#   short window as the US-549 terminal-reason line an operator greps for.
#   Do not "simplify" it back to %U -- it looks correct in the file and is not.
#
# US-604 -- `--password-store=basic`: adopted from the DASHBOARD units, which
#   carry it for a live-tested reason (US-522 reopen). With no `--password-store`
#   chromium auto-detects a Linux backend and picks the GNOME keyring for its
#   OSCrypt "Safe Storage" key; this Pi's Default keyring is password-protected
#   and under PASSWORDLESS auto-login pam_gnome_keyring never unlocks it, so the
#   collection stays LOCKED, chromium's unlock request reaches gcr-prompter, and
#   an "Authentication Required" dialog paints OVER the kiosk. `basic` keeps the
#   key in chromium's own profile -- here /tmp/splash-chromium-shutdown below.
#
#   THE EXPOSURE HERE IS LATENT, and saying so is the point rather than
#   overselling the fix: the measured gcr-prompter prompts (2026-08-03 05:43:09 /
#   08:33:52 / 08:52:23) all tracked the long-running DASHBOARD chromium, none a
#   splash. This unit's window is the shutdown grace period, capped by BLACK_TAIL
#   at 60s, so it is normally far too short to be prompted -- but a dialog
#   painted over THIS splash would obscure the cancel/poweroff state the operator
#   is watching for, and the flag costs nothing.
#
#   DO NOT let "match the dashboard units" delete `--enable-logging=stderr`
#   below. The two units legitimately DIFFER there (US-549 above): the dashboard
#   deliberately carries no logging flag, this one needs it. A test asserts both
#   flags on one pass so a revert aimed at either cannot take the other with it.
# ==============================================================================

[Unit]
Description=Grace-period shutdown splash (Wayland)
After=eclipse-states-http.service
Wants=eclipse-states-http.service

[Service]
Type=simple
User=__PI_USER__
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/__PI_UID__
ExecStart=__CHROMIUM_BIN__ \
  --kiosk \
  --ozone-platform=wayland \
  --noerrdialogs --disable-infobars --hide-scrollbars \
  --autoplay-policy=no-user-gesture-required \
  --check-for-update-interval=31536000 \
  --enable-logging=stderr \
  --password-store=basic \
  --user-data-dir=/tmp/splash-chromium-shutdown \
  http://127.0.0.1:9899/shutdown.html
# Splash exits via its own JS calling window.close() on cancelled / poweroff /
# the BLACK_TAIL 60s safety cap. No hardcoded sleep or external kill (D-3 lesson).
# WHICH of those fired is logged -- grep `journalctl -u splash-grace.service` for
# `[shutdown-splash] terminal` (US-549 / I-043).
