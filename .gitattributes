# ================================================================================
# Git Attributes - Line Ending Configuration
# ================================================================================
# Ensures consistent line endings across Windows (development) and Linux (production)
# ================================================================================

# Default: auto-detect and normalize to LF
* text=auto eol=lf

# Shell scripts must use LF (Linux line endings) - critical for Raspberry Pi
*.sh text eol=lf

# Python files - normalize to LF
*.py text eol=lf

# Config files - normalize to LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.service text eol=lf
*.env text eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# SQL files
*.sql text eol=lf

# Data files
*.csv text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Explicitly mark binary files
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.gz binary
*.exe binary

# PowerShell scripts keep CRLF. Not cosmetic: Windows PowerShell 5.1 parses
# these files as ANSI when the BOM/encoding is disturbed, and an em-dash then
# becomes three cp1252 chars -- which broke quoting inside a double-quoted
# string in Invoke-FleetMerge.ps1 on 2026-08-25 and produced a bogus
# "missing Catch or Finally" parse error. Keep the bytes as authored.
*.ps1 text eol=crlf
