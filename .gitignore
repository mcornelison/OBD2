# ================================================================================
# Python Project .gitignore Template
# ================================================================================

# --------------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
# The generic Python `dist/` rule above also matched specs/UI/dist/ -- the splash
# UI deliverable kit (NOT Python build output). Un-ignore it so the F-103 splash
# assets are version-controlled + deployable (US-393 Rule-10: specs/UI/ updates
# must land in-sprint). specs/UI/dist is a hand-authored design deliverable.
!specs/UI/dist/
!specs/UI/dist/**
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --------------------------------------------------------------------------------
# Virtual Environments
# --------------------------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --------------------------------------------------------------------------------
# IDE and Editors
# --------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# --------------------------------------------------------------------------------
# Testing
# --------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --------------------------------------------------------------------------------
# Jupyter Notebooks
# --------------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --------------------------------------------------------------------------------
# Logs and Databases
# --------------------------------------------------------------------------------
logs/
*.log
*.sqlite3
*.db
# Regression test fixtures — deterministic seed output, checked in for
# diff-based validation. Small (<2 MB) and regenerable via seed_scenarios.py
# (server-side sim) or scripts/export_regression_fixture.sh (pi-side live).
!data/regression/inputs/*.db
!data/regression/pi-inputs/*.db

# --------------------------------------------------------------------------------
# Secrets and Environment
# --------------------------------------------------------------------------------
.env
.env.local
.env.*.local
secrets.json
credentials.json
*.pem
*.key

# --------------------------------------------------------------------------------
# Pi-local config overlay (US-530 / F-126)
# --------------------------------------------------------------------------------
# Operator settings written on the Pi by the settings screen. Layers OVER the
# shipped config.json; deploy-excluded like .env so a deploy never clobbers it.
config.local.json

# --------------------------------------------------------------------------------
# OS Generated
# --------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------------------------------------------
# Project Specific
# --------------------------------------------------------------------------------
# Add project-specific ignores below

# Runtime output
output/
temp/
tmp/

# Agent-fleet offices -- EVICTED from version control 2026-08-24.
# This tree now lives on the fleet share (Z:\O\OBD2v3\offices, $FLEET_SHARE)
# and is NOT version controlled. It stays on disk here in the trunk worktree as
# a transitional convenience; nothing in the repo may depend on it. Recovery for
# these 1836 files is Synology snapshot + Hyper Backup, not git.
offices/

# Downloaded tools (SQLite CLI, etc.). NOTE: `tools/*` not `tools/` so git can
# descend and the negation below works -- tools/pm/ is first-party source (the
# PM tool cluster, moved out of offices/pm/scripts/ in the offices decouple).
tools/*
!tools/pm/

# Claude settings (local only)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Test results (keep committed test specs, ignore outputs)
tests/*_output.txt
tests/test_results_*.txt

# Deploy configuration (contains real Pi connection details)
deploy/deploy.conf


# Honest boot-progress instrument runtime artifacts (Sprint 38 / V0.27.12).
# The breadcrumb trail + its atomic-replace temp are Pi-side runtime state,
# never source; standalone module/test runs write them into data/.
data/boot_progress
data/boot_progress.tmp
data/spool/

